# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: xAI Grok API key for pluggable Grok engine
XAI_API_KEY="MY_XAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Platform (PostgreSQL, Auth, Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# AI Capability Configuration (No hardcoded model names in code)
AI_PROVIDER="gemini"
AI_MODEL_FAST="gemini-3.8-flash"
AI_MODEL_REASONING="gemini-3.1-pro-preview"
AI_MODEL_VISION="gemini-3.8-flash"
AI_MODEL_EMBEDDING="gemini-embedding-2-preview"
AI_MODEL_TRANSCRIPTION="gemini-3.5-transcribe"
AI_MODEL_TTS="gemini-3.8-flash-lite-tts"
